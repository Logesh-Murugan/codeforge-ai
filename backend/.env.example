DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=your-groq-api-key-here

# ── Memory System ─────────────────────────────────────────────────────────────
# Deployment mode: "local" (Ollama + ChromaDB) | "cloud" (HuggingFace + ChromaDB)
MEMORY_MODE=local

# Embedding provider: "local" | "ollama" | "huggingface"
# "local" = zero-dependency hash-projection (always available, dev/CI safe)
# "ollama" = Ollama REST API with nomic-embed-text (best quality, local)
# "huggingface" = HuggingFace Inference API (cloud, requires HF_API_TOKEN)
EMBEDDING_PROVIDER=local

# Fallback chain — first healthy provider wins
EMBEDDING_FALLBACK_CHAIN=ollama,huggingface,local

# LOCAL mode — Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30

# CLOUD mode — HuggingFace Inference API
HF_API_TOKEN=your-huggingface-token-here
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence directory (leave blank for auto: data/chroma_db)
CHROMA_PERSIST_PATH=

# RAG pipeline tuning
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_DEFAULT_LIMIT=5
RAG_DEFAULT_THRESHOLD=0.0

# Embedding cache
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=512

# Context injection
MAX_CONTEXT_CHUNKS=5
CONTEXT_SIMILARITY_THRESHOLD=0.2
CONVERSATION_WINDOW_SIZE=10
